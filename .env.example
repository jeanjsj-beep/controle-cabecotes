# Exemplo de variáveis de ambiente para o SCRC
# Configure estas variáveis no seu ambiente de produção (ex.: painel da Vercel / Docker / Servidor)

# String de conexão PostgreSQL (Supabase / RDS / PostgreSQL Local)
# Formato: postgresql://<usuario>:<senha>@<host>:<porta>/<banco>?sslmode=require
DATABASE_URL=postgresql://usuario:senha_forte@host.pooler.supabase.com:6543/postgres

# Chave secreta mestra para assinatura de tokens de sessão HMAC-SHA256 (mínimo 32 caracteres)
SCRC_SECRET_KEY=gerar_uma_chave_aleatoria_longa_e_secreta_aqui_com_no_minimo_32_caracteres

# Chave de criptografia de dados confidenciais (AES-256)
SCRC_ENCRYPTION_KEY=gerar_uma_chave_hex_ou_string_de_pelo_menos_32_bytes

# Senha inicial para o usuário admin (se não informada, será gerada aleatoriamente na 1ª execução)
SCRC_ADMIN_INITIAL_PASSWORD=TrocarImediatamente@2026!

# Habilitar documentação interativa Swagger (/docs e /openapi.json) - Padrão 0 (desabilitado em produção)
SCRC_ENABLE_DOCS=0

# Origens permitidas adicionais para CORS/CSRF (separadas por vírgula)
ALLOWED_ORIGINS=https://controle-cabecotes-hpef.vercel.app,https://controle-cabecotes.vercel.app
